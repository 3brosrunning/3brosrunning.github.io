<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legacy Item Fact Checker</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            text-align: center;
            padding: 50px 20px;
            margin: 0;
        }
        .container {
            max-width: 500px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        h1 {
            color: #2c3e50;
        }
        input[type="number"] {
            width: 80%;
            padding: 10px;
            font-size: 18px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        button {
            background-color: #3498db;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }
        button:hover {
            background-color: #2980b9;
        }
        .btn-pickup {
            background-color: #27ae60;
            margin-top: 15px;
        }
        .btn-pickup:hover {
            background-color: #219150;
        }
        /* Floating Back Button */
        #floating-back-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 50px;
            padding: 15px 25px;
            font-size: 16px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
            cursor: pointer;
            display: none;
            z-index: 1000;
        }
        #floating-back-btn:hover {
            background-color: #c0392b;
        }
        .result-box {
            display: none;
            margin-top: 20px;
            padding: 20px;
            border-radius: 8px;
            background-color: #ecf0f1;
        }
        .error-link {
            display: block;
            margin-top: 15px;
            color: #e74c3c;
            font-weight: bold;
            text-decoration: none;
        }
        .error-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="container" id="search-view">
        <h1>Legacy Item Checker</h1>
        <p>Enter runner bib number to check legacy status:</p>
        <input type="number" id="bib-input" placeholder="e.g. 1042" required>
        <br>
        <button onclick="checkBib()">Check Bib</button>
        <p id="loading-msg" style="color: gray; font-size: 14px;"></p>
    </div>

    <div class="container result-box" id="result-view">
        <h2 id="result-name"></h2>
        <h3 id="result-status"></h3>
        
        <div id="pickup-action">
            <button class="btn-pickup" onclick="markPickedUp()">Mark as Picked Up</button>
        </div>

        <div id="not-found-action" style="display: none;">
            <p><strong>Result:</strong> No legacy item to be given.</p>
            <a href="https://3brosrunning.github.io/legacytbs.html" class="error-link" target="_blank">Click here to check the Legacy Page</a>
        </div>
    </div>

    <!-- Floating Back Button -->
    <button id="floating-back-btn" onclick="resetToStart()">&#8592; Back to Start</button>

    <script>
        let legacyData = {};
        let currentBib = null;

        // Fetch and parse the CSV on page load
        // Assumes CSV format has Bib in the first column and Name in the second column
        window.onload = async function() {
            document.getElementById('loading-msg').innerText = "Loading data...";
            try {
                const response = await fetch('La_Porte_Nov15_Legacy_Pickups.csv');
                if (!response.ok) throw new Error("CSV not found");
                const csvText = await response.text();
                
                const lines = csvText.split('\n');
                for (let i = 1; i < lines.length; i++) { // Skips header row (i = 1)
                    const row = lines[i].split(',');
                    if (row.length >= 2) {
                        const bib = row[0].trim();
                        const name = row[1].trim();
                        if (bib !== "") {
                            legacyData[bib] = name;
                        }
                    }
                }
                document.getElementById('loading-msg').innerText = "Ready to check!";
            } catch (error) {
                document.getElementById('loading-msg').innerText = "Error: Ensure La_Porte_Nov15_Legacy_Pickups.csv is uploaded.";
                console.error(error);
            }
        };

        function checkBib() {
            const inputField = document.getElementById('bib-input');
            currentBib = inputField.value.trim();
            
            if (!currentBib) {
                alert("Please enter a bib number.");
                return;
            }

            // Hide search view, show results view and floating back button
            document.getElementById('search-view').style.display = 'none';
            document.getElementById('result-view').style.display = 'block';
            document.getElementById('floating-back-btn').style.display = 'block';

            const name = legacyData[currentBib];
            const nameEl = document.getElementById('result-name');
            const statusEl = document.getElementById('result-status');
            const pickupDiv = document.getElementById('pickup-action');
            const notFoundDiv = document.getElementById('not-found-action');

            if (name) {
                // Bib found in CSV
                nameEl.innerText = "Runner: " + name;
                notFoundDiv.style.display = 'none';

                // Check localStorage to see if already picked up
                const isPickedUp = localStorage.getItem('legacy_pickup_' + currentBib);
                
                if (isPickedUp) {
                    statusEl.innerText = "Status: ALREADY PICKED UP \u2705";
                    statusEl.style.color = "red";
                    pickupDiv.style.display = 'none';
                } else {
                    statusEl.innerText = "Status: Item Ready for Pickup \u23F3";
                    statusEl.style.color = "green";
                    pickupDiv.style.display = 'block';
                }
            } else {
                // Bib not found
                nameEl.innerText = "Runner Not Found";
                statusEl.innerText = "";
                pickupDiv.style.display = 'none';
                notFoundDiv.style.display = 'block';
            }
        }

        function markPickedUp() {
            if (currentBib) {
                // Save to local device storage
                localStorage.setItem('legacy_pickup_' + currentBib, 'true');
                
                // Update UI
                const statusEl = document.getElementById('result-status');
                statusEl.innerText = "Status: ALREADY PICKED UP \u2705";
                statusEl.style.color = "red";
                document.getElementById('pickup-action').style.display = 'none';
            }
        }

        function resetToStart() {
            // Reset variables and view
            currentBib = null;
            document.getElementById('bib-input').value = "";
            document.getElementById('search-view').style.display = 'block';
            document.getElementById('result-view').style.display = 'none';
            document.getElementById('floating-back-btn').style.display = 'none';
        }
    </script>

</body>
</html>
